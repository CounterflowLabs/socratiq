# Copy to .env and fill in. Anything left blank uses the default in app/config.py.

# ── Runtime ───────────────────────────────────────────────────────────
ENV=development                  # development | staging | production
AUTH_MODE=local                  # local (single demo user) | jwt (Authorization: Bearer)

# ── Database / Cache / Queue ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://socratiq:socratiq@localhost:5432/socratiq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security (MUST override in production) ───────────────────────────
JWT_SECRET_KEY=change-me-in-production
LLM_ENCRYPTION_KEY=change-me-too
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Google SSO ───────────────────────────────────────────────────────
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ── Authorization ────────────────────────────────────────────────────
# Comma-separated emails granted admin powers (model CRUD, etc.)
ADMIN_EMAILS=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty → localhost dev defaults.
CORS_ORIGINS=

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=

# ── File storage ─────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Whisper ASR ──────────────────────────────────────────────────────
WHISPER_MODE=local               # local | api
WHISPER_MODEL=base
WHISPER_API_KEY=
WHISPER_API_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_MODEL=whisper-large-v3

# ── Bilibili (optional — for authenticated subtitle access) ──────────
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_BUVID3=

# ── LLM transport ────────────────────────────────────────────────────
LLM_TOTAL_TIMEOUT=600.0
LLM_IDLE_TIMEOUT=300.0
LLM_MAX_CONCURRENCY=4
