# Frontend env vars. Variables prefixed NEXT_PUBLIC_ are inlined into the
# browser bundle at build time; everything else is read at runtime by the
# API proxy route handler (src/app/api/[...path]/route.ts).

# Backend URL the proxy forwards to. Read at request time, so it can be
# overridden at deploy with `-e BACKEND_URL=...` without rebuilding.
BACKEND_URL=http://localhost:8000

# OAuth 2.0 Web client ID from Google Cloud Console — needed by /login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
